<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
    
        <record id="module_category_training" model="ir.module.category">
            <field name="name">Training</field>
            <field name="sequence">5</field>
        </record>
        
        <record id="group_training_requester" model="res.groups">
            <field name="name">Requester</field>
            <field name="category_id" ref="training.module_category_training"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]"></field>
            <field name="comment">Access to Registration and My Training Courses Menus</field>
        </record>

        <record id="group_training_teacher" model="res.groups">
            <field name="name">Teacher</field>
            <field name="category_id" ref="training.module_category_training"/>
            <field name="implied_ids" eval="[(4,ref('training.group_training_requester'))]"></field>
            <field name="comment">Access to Registration Menu</field>
        </record>

        <record id="group_training_hr" model="res.groups">
            <field name="name">HR</field>
            <field name="category_id" ref="training.module_category_training"/>
            <field name="implied_ids" eval="[(4,ref('training.group_training_teacher'))]"></field>
            <field name="comment">Access to All Menus</field>
        </record>
    
    </data>
    
    

</odoo>
