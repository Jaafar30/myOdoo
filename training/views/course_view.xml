<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Course Action -->
    <record id="training_action_course" model="ir.actions.act_window">
      <field name="name">Course</field>
      <field name="res_model">training.course</field>
      <field name="view_mode">list,form</field>
    </record>   
<!-- Course Action -->

<!-- Course Form -->
   <record model="ir.ui.view" id="training_course_form">
      <field name="name">Course Form</field>
      <field name="model">training.course</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
            <div class="oe_title">
              <h1>
                  <field name="serial_number" readonly="1" widget="badge"/>
              </h1>
            </div>
            <header></header>
            <group>
              <group>
                <field name="name" />
                <field name="description" />
                <field name="teacher_id" />
                 <field name="deadline" />
              </group>
              <group>
                <group>
                  <field name="start_date" />
                  <field name="start_time" />
                  <field name="number_of_days" />
                </group>
                <group>
                  <field name="end_date" />
                  <field name="end_time" />
                </group>
              </group>
            </group>
            <notebook>
              <page string='Rooms'>
                <group>
                  <field name="room_ids" /> 
                </group>
              </page>
              <page string='Registrations'>
                <group>
                  <field name="registration_ids" /> 
                </group>
              </page>
            </notebook>
            </sheet>
        </form>
      </field>
    </record>
<!-- Course Form -->

</odoo>
