<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- My Training Courses List -->
  <record model="ir.ui.view" id="training_my_courses_list">
    <field name="name">My Training Courses List</field>
    <field name="model">training.registration</field>
    <field name="arch" type="xml">
      <list create="false" delete="false" edit="false">
        <field name="name" />
        <field name="status" />
      </list>
    </field>
  </record>

  <!-- My Training Courses Action -->
  <record id="training_action_my_courses" model="ir.actions.act_window">
    <field name="name">My Courses</field>
    <field name="res_model">training.registration</field>
    <field name="view_mode">list</field>
    <field name="domain">[('trainee_id.user_id', '=', uid), ('status', '=', 'approved')]</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('training.training_my_courses_list')})]"/>
  </record>

</odoo>
