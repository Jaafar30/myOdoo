<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- My Training Courses List -->
  <record model="ir.ui.view" id="training_registration_list">
    <field name="name">Training Registration List</field>
    <field name="model">training.registration</field>
    <field name="arch" type="xml">
      <list create="true" delete="false" edit="false">
        <field name="course_id" />
        <field name="teacher_id" />
        <field name="start_date" />
        <field name="end_date" />
        <field name="start_time" />
        <field name="end_time" />
        <field name="status" />
      </list>
    </field>
  </record>

<!-- Registration Action -->
    <record id="training_action_registration" model="ir.actions.act_window">
      <field name="name">Registration</field>
      <field name="res_model">training.registration</field>
      <field name="view_mode">list,form</field>
       <field name="domain">[('trainee_id.user_id', '=', uid), ('status', '!=', 'approved')]</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('training.training_registration_list')})]"/>
    </record>   
<!-- Registration Action -->



<!-- Form -->
  <record model="ir.ui.view" id="training_registration_form">
    <field name="name">Training Registration Form</field>
    <field name="model">training.registration</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="status" readonly="1" widget="statusbar" />
        </header>
        <sheet>
          <group>
            <group>
              <field name="name" />
              <field name="course_id" domain="[('target_gender', 'in', ('both', gender)), ('deadline', '&gt;=', today_date),('teacher_id','!=',trainee_id)]"/>
              <field name="teacher_id" />
            </group>
            <group>
              <group>
                <field name="start_date" />
                <field name="start_time" />
              </group>
              <group>
                <field name="end_date" />
                <field name="end_time" />
              </group>
            </group>
            
          </group>
          <notebook>
            <page string="Details">
              <group>
                <field name="course_description" />
                <field name="number_of_days" />
                <field name="room_ids" widget="many2many_tags" />
                <field name="location_ids" widget="many2many_tags" />
                <field name="serial_number" readonly="1" />
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
<!-- Form -->


</odoo>
