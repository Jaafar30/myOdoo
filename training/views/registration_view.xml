<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Registration Action -->
    <record id="training_action_registration" model="ir.actions.act_window">
      <field name="name">Registration</field>
      <field name="res_model">training.registration</field>
      <field name="view_mode">list,form</field>
    </record>   
<!-- Registration Action -->

<!-- Registration List -->
   <record model="ir.ui.view" id="training_registration_list">
      <field name="name">Registration List</field>
      <field name="model">training.registration</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
        </list>
      </field>
    </record>
<!-- Registration List -->

<!-- Registration Form -->
   <record model="ir.ui.view" id="training_registration_form">
      <field name="name">Registration Form</field>
      <field name="model">training.registration</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="name"/>
            <field name="course_id" domain="[('deadline', '&gt;=', context_today())]"/>
            <field name="course_description"/>
          </group>
        </form>
      </field>
    </record>
<!-- Registration Form -->
</odoo>
