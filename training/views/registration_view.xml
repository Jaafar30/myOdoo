<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- My Training Courses List -->
  <record model="ir.ui.view" id="training_registration_list">
    <field name="name">Training Registration List</field>
    <field name="model">training.registration</field>
    <field name="arch" type="xml">
      <list create="true" delete="false" edit="false">
        <field name="name" />
        <field name="status" />
      </list>
    </field>
  </record>

<!-- Registration Action -->
    <record id="training_action_registration" model="ir.actions.act_window">
      <field name="name">Registration</field>
      <field name="res_model">training.registration</field>
      <field name="view_mode">list,form</field>
       <field name="domain">[('trainee_id.user_id', '=', uid), ('status', '!=', 'approved')]</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('training.training_registration_list')})]"/>
    </record>   
<!-- Registration Action -->
</odoo>
