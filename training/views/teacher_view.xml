<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Teacher Action -->
    <record id="training_action_teacher" model="ir.actions.act_window">
      <field name="name">Teacher</field>
      <field name="res_model">training.teacher</field>
      <field name="view_mode">list,form</field>
    </record>   
<!-- Teacher Action -->

<!-- Teacher List -->
   <record model="ir.ui.view" id="training_teacher_list">
      <field name="name">Teacher List</field>
      <field name="model">training.teacher</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="teacher_id"/>
          <field name="course_id" edit="0"/>
        </list>
      </field>
    </record>
<!-- Teacher List -->

<!-- Teacher Form -->
   <record model="ir.ui.view" id="training_teacher_form">
      <field name="name">Teacher Form</field>
      <field name="model">training.teacher</field>
      <field name="arch" type="xml">
        <form>
          <group>
            <field name="name"/>
            <field name="teacher_id"/>
            <field name="course_id"/>
          </group>
        </form>
      </field>
    </record>
<!-- Teacher Form -->






</odoo>
