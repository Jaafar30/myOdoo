<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- List -->
  <record model="ir.ui.view" id="training_teacher_list">
    <field name="name">Training Teacher List</field>
    <field name="model">training.registration</field>
    <field name="arch" type="xml">
      <list create="false" delete="false" edit="true">
        <field name="name" />
        <field name="status" />
        <!-- Buttons -->
        <button name="confirm_registration" string="Approve" type="object" class="btn-primary" />
        <button name="reject_registration" string="Reject" type="object" class="btn-danger" />
      </list>
    </field>
  </record>

<!-- Action -->
  <record id="training_action_teacher" model="ir.actions.act_window">
    <field name="name">Teacher</field>
    <field name="res_model">training.registration</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('teacher_id.user_id', '=', uid), ('status', '=', 'draft')]</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('training.training_teacher_list')})]"/>
  </record>
<!-- Action -->

</odoo>
